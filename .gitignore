__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/

# --- Front-ends (build them locally: see README) ---
ui/node_modules/
ui/dist/
dashboard/node_modules/
dashboard/dist/

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
*.log
output.txt
